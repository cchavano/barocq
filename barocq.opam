opam-version: "2.0"
name: "project"
version: "0.5~dev"
synopsis: "The Barocq compiler"
maintainer: "Clément Chavanon <clement.chavanon@inria.fr>"
authors: "Clément Chavanon and Frédéric Besson"
homepage: "https://gitlab.inria.fr/cchavano/barocq"
license: "INRIA Non-Commercial License Agreement"
bug-reports: "https://gitlab.inria.fr/cchavano/barocq/-/issues"
dev-repo: "git+https://gitlab.inria.fr/cchavano/barocq.git#v0.5"
depends: [
  "ocaml" {= "4.14.2"}
  "menhir" {= "20250912"}
  "coq" {>= "8.20.1" and <= "9.0.1"}
  "coq-record-update" {= "0.3.6"}
  "coq-vst-zlist" {= "2.13"}
  "compcert-ce" {= "3.16-20260122ce"}
]
pin-depends: ["compcert-ce.3.16-20260122ce" "git+https://gitlab.inria.fr/cchavano/compcert-ce.git"]
build: [[make]]
install: [make "install" "install-dev"]
