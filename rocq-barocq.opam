opam-version: "2.0"
version: "dev"
synopsis: "The Barocq compiler"
maintainer: "Clément Chavanon <clement.chavanon@inria.fr>"
authors: "Clément Chavanon and Frédéric Besson"
homepage: "https://github.com/cchavano/barocq"
license: "LGPL-3.0-only"
bug-reports: "https://github.com/cchavano/barocq/issues"
dev-repo: "git+https://github.com/cchavano/barocq.git"
depends: [
  "ocaml" {>= "4.14" }
  "menhir" {>= "20200624" & != "20260122" & != "dev"}
  "coq" {>= "8.20.1" & < "9.3~"}
  "coq-record-update" {= "0.3.6"}
  "coq-vst-zlist" {= "2.13"}
  "compcert-brc" {= "3.18-brc1"}
  "rocq-barocq-lib" {= "dev"}
]
pin-depends: ["compcert-brc.3.18-brc1" "git+https://github.com/cchavano/CompCert-Brc#main"]
build: [make "nolib"]
install: [make "install-nolib"]
