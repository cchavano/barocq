# COMPCERT_CONFIG = $(COQLIB)/user-contrib/compcert/compcert.config
# ARCH=$(shell cat $(COMPCERT_CONFIG) | grep ARCH | cut -d= -f2)

BUILD_DIR = _build
BDIRS_SOURCE=src printer bparser

-include $(COMPCERT_DIR)/Makefile.config