CCOMP = $(shell command -v ccomp)
OPAMSWITCH_DIR = $(realpath $(dir $(CCOMP))/../)
INSTALL_DIR = $(OPAMSWITCH_DIR)/bin
COMPCERT_VER = $(shell opam info -f version coq-compcert)
COMPCERT_DIR = $(OPAMSWITCH_DIR)/.opam-switch/build/coq-compcert.$(COMPCERT_VER)
