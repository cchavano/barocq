CCOMP = $(shell command -v ccomp)
OPAMSWITCH_DIR = $(realpath $(dir $(CCOMP))/../)
INSTALL_DIR = $(OPAMSWITCH_DIR)/bin
COMPCERT_VER = $(shell opam info -f version compcert-ce)
COMPCERT_DIR = $(OPAMSWITCH_DIR)/.opam-switch/build/compcert-ce.$(COMPCERT_VER)

BUILD_DIR = _build
MLDIRS=frontend backend printer bparser bcomp

-include $(COMPCERT_DIR)/Makefile.config