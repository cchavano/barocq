{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Barocq",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#directives" },
		{ "include": "#operators" },
		{ "include": "#types_cast" },
		{ "include": "#keywords"},
		{ "include": "#literals" },
		{ "include": "#types_builtin" },
		{ "include": "#identifiers"}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"comment": "control keyword",
					"name": "keyword.control.barocq",
					"match": "\\b(if|then|else|match|with|end)\\b"
				},
                {
                    "comment": "other keyword",
				    "name": "keyword.other.barocq",
				    "match": "\\b(module|import|enum|record|type|defn|decl|let|in|compute|of)\\b"
                }
            ]
		},
		"operators": {
            "patterns": [
                {
                    "comment": "infix operator",
                    "name": "keyword.operator.barocq",
                    "match": "<-|[.+\\-\\*/%\\^<>&\\|]"
                },
                {
                    "comment": "prefix operator",
                    "name": "keyword.operator.barocq",
                    "match": "[+\\-!~]"
                },
                {
                    "comment": "binding operator",
                    "name": "keyword.operator.barocq",
                    "match": "="
                },
                {
					"comment": "annotation",
					"name": "storage.modifier.barocq",
					"match": "(@\\w+)"
				}
            ]
        },
		"types_builtin": {
            "patterns": [
                {
                    "comment": "builtin type",
                    "name": "entity.name.type.barocq",
                    "match": "\\b(bool|i32|u32|i64|u64)\\b"
                }
			]
		},
		"types": {
			"patterns": [
				{ "include": "#types_builtin" },
				{
					"comment": "user-defined type",
					"match": "((\\w+)(::))?(\\w+)",
					"captures": {
						"2": { "name": "entity.name.namespace.barocq" },
						"3": { "name": "keyword.operator.barocq" },
						"4": { "name": "entity.name.type.barocq" }
					}
				},
				{
					"comment": "unboxed array size",
					"begin": ";",
					"end": "]",
					"patterns": [
						{ "include": "#identifiers" },
						{ "include": "#literals" },
						{ "include": "#operators" }
					]
				}
			]
		},
		"types_decl": {
			"patterns": [
				{
					"comment": "type declaration",
					"begin": ":\\s*",
					"end": "((\\w+)(::))?(\\w+)",
					"endCaptures": {
						"2": { "name": "entity.name.namespace.barocq" },
						"3": { "name": "keyword.operator.barocq" },
						"4": { "name": "entity.name.type.barocq" } 
					},
					"patterns": [
						{ "include": "#types_builtin" }
					]
				},
				{
					"comment": "unboxed array size",
					"begin": ";",
					"end": "]",
					"patterns": [
						{ "include": "#identifiers" },
						{ "include": "#literals" },
						{ "include": "#operators" }
					]
				}
			]
		},
		"types_cast": {
			"patterns": [
				{
					"comment": "type cast",
					"match": "\\b(as)\\s+((\\w+)(::))?(\\w+)",
					"captures": {
						"1": { "name": "keyword.operator.barocq" },
						"3": { "name": "entity.name.namespace.barocq" },
						"4": { "name": "keyword.operator.barocq" },
						"5": { "name": "entity.name.type.barocq" }
					}
				}
			]
		},
		"directives": {
			"patterns": [
                {
                    "comment": "module definition",
                    "match": "\\b(module)\\s+(\\w+)",
                    "captures": {
                        "1": { "name": "keyword.other.barocq" },
                        "2": { "name": "entity.name.namespace.barocq" }
                    }
                },
                {
                    "comment": "module import",
                    "match": "\\b(import)\\s+(\\w+)",
                    "captures": {
                        "1": { "name": "keyword.other.barocq" },
                        "2": { "name": "entity.name.namespace.barocq" }
                    }
                },
				{
					"comment": "abstrat function declaration",
					"begin": "\\b(decl)\\s+(\\w+)\\s*:\\s+\\(",
					"end": "$",
					"beginCaptures": {
						"1": { "name": "keyword.other.barocq" },
						"2": { "name": "entity.name.function.barocq" }
					},
					"patterns": [
						{ "include": "#operators" },
						{ "include": "#keywords" },
						{ "include": "#types" }
					]
				},
				{
					"comment": "abstract constant declaration",
					"begin": "\\b(decl)\\s+(\\w+)\\s*:",
					"end": "$",
					"beginCaptures": {
						"1": { "name": "keyword.other.barocq" },
						"2": { "name": "variable.name.barocq" }
					},
					"patterns": [
						{ "include": "#types" }
					]
				},
				{
					"comment": "function definition",
					"begin": "\\b(defn)\\s+(\\w+)\\s*\\(",
					"end": "(=)",
					"beginCaptures": {
						"1": { "name": "keyword.other.barocq" },
						"2": { "name": "entity.name.function.barocq" }
					},
					"endCaptures": {
						"1": { "name": "keyword.operator.barocq" }
					},
					"patterns": [
						{ "include": "#types_decl" }
					]
				},
				{
					"comment": "constant definition",
					"begin": "\\b(defn)\\s+(\\w+)\\s*:",
					"end": "(=)",
					"beginCaptures": {
						"1": { "name": "keyword.other.barocq" },
						"2": { "name": "variable.name.barocq" }
					},
					"endCaptures": {
						"1": { "name": "keyword.operator.barocq" }
					},
					"patterns": [
						{ "include": "#types" }
					]
				},
				{
					"comment": "enum type definition",
					"begin": "\\b(enum)\\s+(\\w+)\\s*{",
					"end": "}",
					"beginCaptures": {
						"1": { "name": "keyword.other.barocq" },
						"2": { "name": "entity.name.type.barocq" },
						"3": { "name": "keyword.operator.barocq" }
					},
					"patterns": [
						{ "include": "#comments" }
					]
				},
				{
					"comment": "record type definition",
					"begin": "\\b(record)\\s+(\\w+)\\s*{",
					"end": "}",
					"beginCaptures": {
						"1": { "name": "keyword.other.barocq" },
						"2": { "name": "entity.name.type.barocq" },
						"3": { "name": "keyword.operator.barocq" }
					},
					"patterns": [
						{ "include": "#comments" },
						{ "include": "#types_decl" }
					]
				},
				{
					"comment": "type alias",
					"begin": "\\b(type)\\s+(\\w+)\\s+(=)",
					"end": "$",
					"beginCaptures": {
						"1": { "name": "keyword.other.barocq" },
						"2": { "name": "entity.name.type.barocq" },
						"3": { "name": "keyword.operator.barocq" }
					},
					"patterns": [
						{ "include": "#types" }
					]
				},
				{
					"comment": "abstract type declaration",
					"begin": "\\b(type)\\s+(\\w+)\\s+(of)",
					"end": "$",
					"beginCaptures": {
						"1": { "name": "keyword.other.barocq" },
						"2": { "name": "entity.name.type.barocq" },
						"3": { "name": "keyword.other.barocq" }
					},
					"patterns": [
						{ "include": "#strings" }
					]
				}
			]
		},
		"literals": {
            "patterns": [
                {
                    "comment": "boolean literal",
                    "name": "constant.language.boolean.barocq",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "comment": "decimal integer literal",
                    "name": "constant.numeric.integer.barocq",
                    "match": "\\b\\d(\\d|_)*(u?l?|U?L?)\\b"
                },
                {
                    "comment": "hexadecimal integer literal",
                    "name": "constant.numeric.integer.barocq",
                    "match": "\\b(0x|0X)[[:xdigit:]][[:xdigit:]|_]*(u?l?|U?L?)\\b"
                }
            ]
        },
		"identifiers": {
            "patterns": [
                {
                    "comment": "module name",
                    "match": "\\b(\\w+)(::)",
                    "captures": {
                        "1": { "name": "entity.name.namespace.barocq" },
                        "2": { "name": "keyword.operator.barocq" }
                    }
                },
				{
                    "comment": "function call",
                    "match": "\\b(\\w+)\\s*\\((?=[^*])",
                    "captures": {
                        "1": { "name": "entity.name.function.barocq" }
                    }
                },
				{
					"comment": "record field or function parameter",
					"match": "\\b(\\w+)\\s*:",
					"capture": {
						"1": { "name": "entity.name.variable.barocq" }
					}
				},
                {
                    "comment": "patter-matching wildcard",
                    "name": "constant.language.barocq",
                    "match": "\\b_\\b"
                }
			]
		},
		"strings": {
			"patterns": [
				{
					"comment": "string literal",
					"name": "string.quoted.double.ocaml",
					"begin": "\"",
					"end": "\""
				}
			]
		},
		"comments": {
            "patterns": [
                {
                    "comment": "block comment",
                    "begin": "\\(\\*",
                    "end": "\\*\\)",
                    "name": "comment.block.barocq",
                    "patterns": [
                        { "include": "#comments" }
                    ]
                }
            ]
        }
    },
	"scopeName": "source.barocq"
}