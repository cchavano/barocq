{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Barocq",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#declarations" },
		{ "include": "#definitions" },
		{ "include": "#operators" },
		{ "include": "#keywords"},
		{ "include": "#literals" },
		{ "include": "#types" },
		{ "include": "#identifiers"}
	],
	"repository": {
		"keywords": {
			"patterns": [
                {
                    "comment": "reserved keyword",
				    "name": "keyword.other.barocq",
				    "match": "\\b(module|type|struct|def|let|in|if|then|else|as|compute)\\b"
                }
            ]
		},
		"operators": {
            "patterns": [
                {
                    "comment": "infix operator",
                    "name": "keyword.operator.barocq",
                    "match": "<-|[.+\\-\\*/%\\^<>!&\\|]"
                },
                {
                    "comment": "prefix operator",
                    "name": "keyword.operator.barocq",
                    "match": "[+\\-]"
                },
                {
                    "comment": "binding operator",
                    "name": "keyword.operator.barocq",
                    "match": "="
                }
            ]
        },
		"types": {
            "patterns": [
                {
                    "comment": "builtin type",
                    "name": "entity.name.type.barocq",
                    "match": "\\b(bool|i32|u32|i64|u64|array)\\b"
                }
			]
		},
		"types_decl": {
			"patterns": [
				{
					"comment": "type declaration or right side of type definition",
					"match": "(?<=[=:]\\s+(array\\s+)*)((\\w+)(::))?(\\w+)",
					"captures": {
						"3": { "name": "entity.name.namespace.barocq" },
						"4": { "name": "keyword.operator.barocq" },
						"5": { "name": "entity.name.type.barocq" }
					}
				}
			]
		},
		"definitions": {
			"patterns": [
				{
					"comment": "function definition",
					"begin": "\\b(def)\\s+(\\w+)\\s*\\(",
					"end": "(=)",
					"beginCaptures": {
						"1": { "name": "keyword.other.barocq" },
						"2": { "name": "entity.name.function.barocq" }
					},
					"endCaptures": {
						"1": { "name": "keyword.operator.barocq" }
					},
					"patterns": [
						{ "include": "#types_decl" }
					]
				},
				{
					"comment": "constant definition",
					"begin": "\\b(def)\\s+(\\w+)",
					"end": "(=)",
					"beginCaptures": {
						"1": { "name": "keyword.other.barocq" },
						"2": { "name": "variable.name.barocq" }
					},
					"endCaptures": {
						"1": { "name": "keyword.operator.barocq" }
					},
					"patterns": [
						{ "include": "#types_decl" }
					]
				},
				{
					"comment": "struct type definition",
					"begin": "\\b(struct)\\s+(\\w+)\\s+(=)",
					"end": "}",
					"beginCaptures": {
						"1": { "name": "keyword.other.barocq" },
						"2": { "name": "entity.name.type.barocq"},
						"3": { "name": "keyword.operator.barocq" }
					},
					"patterns": [
						{ "include": "#comments" },
						{ "include": "#types_decl" }
					]
				},
				{
					"comment": "type alias definition",
					"begin": "\\b(type)\\s+(\\w+)\\s+(=)",
					"end": "$",
					"beginCaptures": {
						"1": { "name": "keyword.other.barocq" },
						"2": { "name": "entity.name.type.barocq" },
						"3": { "name": "keyword.operator.barocq" }
					},
					"patterns": [
						{ "include": "#types_decl" }
					]
				}
			]
		},
		"declarations": {
            "patterns": [
                {
                    "comment": "module declaration",
                    "match": "\\b(module)\\s+(\\w+)",
                    "captures": {
                        "1": { "name": "keyword.other.barocq" },
                        "2": { "name": "entity.name.namespace.barocq" }
                    }
                }
            ]
        },
		"literals": {
            "patterns": [
                {
                    "comment": "boolean literal",
                    "name": "constant.language.boolean.barocq",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "comment": "decimal integer literal",
                    "name": "constant.numeric.integer.barocq",
                    "match": "\\b\\d(\\d|_)*[U]?[L]?\\b"
                },
                {
                    "comment": "hexadecimal integer literal",
                    "name": "constant.numeric.integer.barocq",
                    "match": "\\b(0x|0X)[[:xdigit:]][[:xdigit:]|_]*[U]?[L]?\\b"
                }
            ]
        },
		"identifiers": {
            "patterns": [
                {
                    "comment": "module name",
                    "match": "(\\w+)(::)",
                    "captures": {
                        "1": { "name": "entity.name.namespace.barocq" },
                        "2": { "name": "keyword.operator.barocq" }
                    }
                },
				{
                    "comment": "function call",
                    "match": "(\\w+)\\s*\\((?=[^*])",
                    "captures": {
                        "1": { "name": "entity.name.function.barocq" }
                    }
                }

			]
		},
		"comments": {
            "patterns": [
                {
                    "comment": "block comment",
                    "begin": "\\(\\*",
                    "end": "\\*\\)",
                    "name": "comment.block.barocq",
                    "patterns": [
                        { "include": "#comments" }
                    ]
                }
            ]
        }
    },
	"scopeName": "source.barocq"
}